# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=RAGPipeline
APP_ENV=development
LOG_LEVEL=INFO
PRODUCT_NAME="IBM Guardium Data Protection (GDP)"

# ─── Milvus ───────────────────────────────────────────────────────────────────
MILVUS_MODE=standalone
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=GDP_RAG_Chunks_v19
MILVUS_DIMENSION=384

# ─── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DELAY=0.0

# ─── Provider (Local Ollama) ──────────────────────────────────────────────────
LLM_BASE_URL=https://aim.dev03.dev.guardium.security.ibm.com
LLM_API_KEY=<add api key>
LLM_ENABLED=true

LLM_MODEL=Suraj/instance/watsonx/ibm/granite-4-h-small

LLM_STREAM=false
LLM_STREAM_REQUIRE_DONE=true

LLM_HTTP_VERSION=1.1
LLM_USER_AGENT=ragpipeline/1.0

# ─── Token budget ─────────────────────────────────────────────────────────────
LLM_CONTEXT_WINDOW=131072
LLM_INPUT_WINDOW_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=32000
LLM_MAX_TOKENS=8000
LLM_COMPACT_SCHEMA=false
LLM_THINKING=low

LLM_CLEAN_ENABLED=false
LLM_TIMEOUT=300
LLM_CONCURRENCY=8
LLM_MAX_ENTRIES=150
LLM_REQUEST_DELAY=0.2
LLM_EXTRACTION_MODE=parallel

# ─── Debugging (keep on) ──────────────────────────────────────────────────────
LLM_DEBUG_RAW_DIR=./debug/llm_raw
LLM_DEBUG_MIN_CHARS=50

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_STRATEGY=recursive
CHUNK_TARGET_TOKENS=512
CHUNK_CEILING_TOKENS=640
CHUNK_OVERLAP_TOKENS=64
CHUNK_LEAF_MIN_TOKENS=20
CHARS_PER_TOKEN=4.5

# ─── Summarization ────────────────────────────────────────────────────────────
SUMMARIZE_ENABLED=true
EMBED_SUMMARIES=true
EMBED_ALL_NODES=true

# ─── Retrieval ────────────────────────────────────────────────────────────────
SEARCH_ON_SUMMARY=true
CONTENT_FALLBACK_THRESHOLD=0.65
SCORE_W_SUMMARY=0.70
SCORE_W_CONTENT=0.25
SCORE_W_FACET=0.25
COS_FLOOR=0.25
COS_CEIL=0.85

RETRIEVAL_MIN_COSINE=0.55
RETRIEVAL_FALLBACK_TO_BEST=true

# ─── Cleaning ─────────────────────────────────────────────────────────────────
STRIP_COMMAND_REFERENCE=true
COMMAND_REF_DENSITY=0.6
COMMAND_REF_MIN_LINES=3

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
JSONL_OUTPUT_DIR=./output
MD_OUTPUT_DIR=output
SUMMARY_DIR=uploads/summary